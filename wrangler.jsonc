{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arno-dashboard",
  "compatibility_date": "2026-11-19",
  "observability": {
    "enabled": true
  },
  // Site statique : dist/ est produit par `npm run build`.
  "assets": {
    "directory": "dist",
    "not_found_handling": "single-page-application"
  }
}
